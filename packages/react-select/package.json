{
  "name": "react-select-fast",
  "version": "0.1.0",
  "description": "Drop-in, API-identical react-select with far less render work on large menus",
  "main": "dist/react-select-fast.cjs.js",
  "module": "dist/react-select-fast.esm.js",
  "types": "dist/react-select-fast.cjs.d.ts",
  "sideEffects": false,
  "author": "Yasu Flores",
  "contributors": [
    "Jed Watson (original react-select author)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yasuf/react-select-fast.git",
    "directory": "packages/react-select"
  },
  "homepage": "https://github.com/yasuf/react-select-fast#readme",
  "bugs": "https://github.com/yasuf/react-select-fast/issues",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^7.12.0",
    "@emotion/cache": "^11.4.0",
    "@emotion/react": "^11.8.1",
    "@floating-ui/dom": "^1.0.1",
    "@types/react-transition-group": "^4.4.0",
    "memoize-one": "^6.0.0",
    "react-transition-group": "^4.3.0",
    "use-isomorphic-layout-effect": "^1.2.0"
  },
  "devDependencies": {
    "@types/jest-in-case": "^1.0.6",
    "enzyme": "^3.8.0",
    "enzyme-to-json": "^3.3.0",
    "jest-in-case": "^1.0.2",
    "react": "^16.13.0",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "files": [
    "dist",
    "base",
    "animated",
    "async",
    "creatable",
    "async-creatable"
  ],
  "keywords": [
    "combobox",
    "form",
    "input",
    "multiselect",
    "react",
    "react-component",
    "select",
    "ui"
  ],
  "preconstruct": {
    "entrypoints": [
      "index.ts",
      "base/index.ts",
      "animated/index.ts",
      "async/index.ts",
      "creatable/index.ts",
      "async-creatable/index.ts"
    ]
  },
  "exports": {
    ".": {
      "module": "./dist/react-select-fast.esm.js",
      "import": "./dist/react-select-fast.cjs.mjs",
      "default": "./dist/react-select-fast.cjs.js"
    },
    "./base": {
      "module": "./base/dist/react-select-fast-base.esm.js",
      "import": "./base/dist/react-select-fast-base.cjs.mjs",
      "default": "./base/dist/react-select-fast-base.cjs.js"
    },
    "./async": {
      "module": "./async/dist/react-select-fast-async.esm.js",
      "import": "./async/dist/react-select-fast-async.cjs.mjs",
      "default": "./async/dist/react-select-fast-async.cjs.js"
    },
    "./animated": {
      "module": "./animated/dist/react-select-fast-animated.esm.js",
      "import": "./animated/dist/react-select-fast-animated.cjs.mjs",
      "default": "./animated/dist/react-select-fast-animated.cjs.js"
    },
    "./creatable": {
      "module": "./creatable/dist/react-select-fast-creatable.esm.js",
      "import": "./creatable/dist/react-select-fast-creatable.cjs.mjs",
      "default": "./creatable/dist/react-select-fast-creatable.cjs.js"
    },
    "./async-creatable": {
      "module": "./async-creatable/dist/react-select-fast-async-creatable.esm.js",
      "import": "./async-creatable/dist/react-select-fast-async-creatable.cjs.mjs",
      "default": "./async-creatable/dist/react-select-fast-async-creatable.cjs.js"
    },
    "./package.json": "./package.json"
  }
}
